# Roblox Sync Gallery - Backend Configuration
PORT=4000
HOST=0.0.0.0
DAEMON_SECRET=roblox-sync-gallery-secret-token

# Storage Driver: 'local', 'supabase', or 'r2'
STORAGE_DRIVER=local

# Public Base URL for local image serving (use your laptop IP if testing from mobile phone, e.g. http://192.168.1.10:4000)
PUBLIC_BASE_URL=http://localhost:4000

# =========================================================
# Supabase Storage Credentials (Jika STORAGE_DRIVER=supabase)
# =========================================================
SUPABASE_URL=https://your-project.supabase.co
# Gunakan service_role key atau anon key (jika bucket public)
SUPABASE_KEY=your_supabase_api_key
SUPABASE_BUCKET=roblox-gallery

# =========================================================
# Cloudflare R2 Credentials (Jika STORAGE_DRIVER=r2)
# =========================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
